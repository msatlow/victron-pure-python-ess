[Unit]
Description=Read MPPT Solar 
After=multi-user.target

[Service]
Type=simple
Restart=always
ExecStart=/usr/bin/python3 /home/msatlow/mppt_to_mqtt.py --config config_mppt1.ini
WorkingDirectory=/home/msatlow
RestartSec=10
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
