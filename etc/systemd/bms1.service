[Unit]
Description=Read BMS 
After=multi-user.target

[Service]
Type=simple
Restart=always
ExecStart=/usr/bin/python3 /opt/victron-pure-python-ess/seplos.py --config config.ini
WorkingDirectory=/opt/victron-pure-python-ess
RestartSec=10
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
